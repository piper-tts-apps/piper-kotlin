 using json = nlohmann::json;
 
+// --- Android port patch: espeak-ng is process-global, but piper_free()
+// terminated it per synthesizer. With several live synthesizers (one per
+// PiperEngine, plus tests) freeing one engine killed espeak for the rest:
+// use-after-terminate produced silent phonemization failures, and a second
+// terminate (or a failed re-init, which calls exit(1)) crashed the process.
+// Synthesizers now share espeak through a refcount: initialized once,
+// terminated when the last synthesizer is freed. ---
+namespace {
+std::mutex g_espeak_ref_mutex;
+int g_espeak_ref_count = 0;
+
+// Must hold g_espeak_ref_mutex.
+void espeak_release_locked() {
+  if (--g_espeak_ref_count <= 0) {
+    g_espeak_ref_count = 0;
+    espeak_Terminate();
+  }
+}
+}  // namespace
+
 // Decoder chunking for streaming. A context of STREAM_CONTEXT_FRAMES latent
 // frames on each side makes the chunked output identical to decoding the
 // whole sentence at once (the decoder's receptive field is smaller).
@@ -141,16 +162,33 @@ auto piper_create_with_options(const piper_create_options *options)
   }
 
   std::ifstream config_stream(config_path_str);
-  auto config = json::parse(config_stream);
+  json config;
+  try {
+    config = json::parse(config_stream);
+  } catch (...) {
+    // Android port patch: a corrupt config must fail creation, not abort.
+    return nullptr;
+  }
   PhonemeType phoneme_type = PhonemeType::Espeak;
   if (config.contains("phoneme_type")) {
     phoneme_type = config["phoneme_type"].get<PhonemeType>();
   }
 
-  if (phoneme_type == PhonemeType::Espeak &&
-      espeak_Initialize(AUDIO_OUTPUT_SYNCHRONOUS, 0, final_espeak_data_path,
-                        0) < 0) {
-    return nullptr;
+  // Android port patch: see the g_espeak_ref_count note above. The first
+  // live Espeak synthesizer initializes espeak; further ones just bump the
+  // refcount. (First engine's espeak data dir wins; all engines share it.)
+  bool espeak_acquired = false;
+  if (phoneme_type == PhonemeType::Espeak) {
+    {
+      std::lock_guard<std::mutex> lock(g_espeak_ref_mutex);
+      if (g_espeak_ref_count == 0 &&
+          espeak_Initialize(AUDIO_OUTPUT_SYNCHRONOUS, 0, final_espeak_data_path,
+                            0) < 0) {
+        return nullptr;
+      }
+      ++g_espeak_ref_count;
+    }
+    espeak_acquired = true;
   }
 
   auto *synth = new piper_synthesizer();
@@ -379,6 +417,10 @@ auto piper_create_with_options(const piper_create_options *options)
   ::MultiByteToWideChar(CP_ACP, 0, model_path, -1, &model_path_wc[0], sz);
   auto model_path_ort = &model_path_wc[0];
 #endif
